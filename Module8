<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MOD_08 | Descriptive Statistics</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Inter:wght@400;600;800&display=swap');

        :root {
            --bg-main: #0b0f19;
            --bg-card: #151b2b;
            --bg-panel: #1e2638;
            --text-main: #e2e8f0;
            --text-muted: #8b9bb4;
            --accent-cyan: #06b6d4;
            --accent-blue: #3b82f6;
            --accent-red: #ef4444;
            --accent-green: #22c55e;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            padding: 40px 20px;
            background-image: 
                linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        #analysis-dashboard {
            width: 100%;
            max-width: 1000px;
            background-color: var(--bg-card);
            border: 1px solid var(--accent-cyan);
            border-radius: 8px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding-bottom: 15px;
            margin-bottom: 25px;
        }

        .back-btn {
            background: none;
            border: 1px solid var(--text-muted);
            color: var(--text-muted);
            padding: 8px 15px;
            border-radius: 5px;
            cursor: pointer;
            font-family: 'Fira Code', monospace;
            font-size: 0.85rem;
            transition: all 0.2s;
        }

        .back-btn:hover {
            color: var(--text-main);
            border-color: var(--text-main);
            background-color: rgba(255,255,255,0.05);
        }

        .upload-section {
            border: 2px dashed rgba(6, 182, 212, 0.5);
            border-radius: 8px;
            padding: 40px;
            text-align: center;
            margin-bottom: 30px;
            background-color: rgba(6, 182, 212, 0.05);
            transition: all 0.2s;
        }

        .upload-section.drag-active {
            border-color: var(--accent-cyan);
            background-color: rgba(6, 182, 212, 0.12);
        }

        .upload-section input[type="file"] { display: none; }

        .upload-label {
            background-color: var(--accent-blue);
            color: white;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            display: inline-block;
            margin-top: 15px;
        }

        .upload-hint {
            color: var(--text-muted);
            font-family: 'Fira Code', monospace;
            font-size: 0.8rem;
            margin-top: 10px;
        }

        #column-selector {
            display: none;
            text-align: center;
            margin-bottom: 30px;
            background: var(--bg-panel);
            padding: 15px;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.1);
        }

        #column-selector .meta-row {
            margin-top: 10px;
            font-family: 'Fira Code', monospace;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        select {
            padding: 10px;
            border-radius: 5px;
            background: var(--bg-main);
            color: var(--text-main);
            border: 1px solid var(--accent-cyan);
            font-family: 'Inter', sans-serif;
            font-size: 1rem;
            min-width: 200px;
            margin-left: 10px;
            cursor: pointer;
        }

        .results-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 25px;
        }

        .stat-card {
            background-color: var(--bg-panel);
            padding: 20px;
            border-radius: 8px;
            border-left: 4px solid var(--accent-blue);
        }

        .stat-card h3 {
            font-size: 0.85rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .stat-card .value {
            font-size: 1.5rem;
            font-family: 'Fira Code', monospace;
            color: var(--accent-cyan);
            font-weight: bold;
        }

        .outlier-box {
            grid-column: 1 / -1;
            border-left-color: var(--accent-red);
        }
        
        .outlier-box .value { color: var(--accent-red); font-size: 1rem; word-wrap: break-word;}

        .viz-section {
            display: none;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 25px;
        }

        .viz-card {
            background-color: var(--bg-panel);
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.1);
            padding: 15px;
        }

        .viz-card h3 {
            font-size: 0.8rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .viz-card svg { width: 100%; height: auto; display: block; }

        .actions-row {
            display: none;
            justify-content: flex-end;
            margin-bottom: 10px;
        }

        .download-btn {
            background-color: transparent;
            border: 1px solid var(--accent-green);
            color: var(--accent-green);
            padding: 8px 15px;
            border-radius: 5px;
            cursor: pointer;
            font-family: 'Fira Code', monospace;
            font-size: 0.85rem;
            transition: all 0.2s;
        }

        .download-btn:hover {
            background-color: rgba(34, 197, 94, 0.1);
        }

        @media (max-width: 700px) {
            .viz-section { grid-template-columns: 1fr; }
        }

        @media (max-width: 600px) {
            select { margin-top: 10px; width: 100%; margin-left: 0; }
        }
    </style>
</head>
<body>

    <section id="analysis-dashboard">
        <div class="dashboard-header">
            <h2>MOD_08: Descriptive Statistics Engine</h2>
            <!-- Returns to the main menu -->
            <button class="back-btn" onclick="window.location.href='index.html'">← Back to Workspace</button>
        </div>

        <div class="upload-section" id="upload-zone">
            <p>Upload a .CSV file with headers. The system will detect numerical columns.</p>
            <label class="upload-label">
                Select Multi-column CSV
                <input type="file" id="csvFile" accept=".csv" onchange="processData(event)">
            </label>
            <p class="upload-hint">or drag &amp; drop a .csv file here</p>
            <p id="file-name" style="margin-top: 10px; color: var(--accent-cyan); font-family: 'Fira Code';"></p>
        </div>

        <div id="column-selector">
            <label for="col-select" style="font-weight: 600;">Select Column to Analyze:</label>
            <select id="col-select" onchange="analyzeSelectedColumn()"></select>
            <div class="meta-row" id="col-meta"></div>
        </div>

        <div class="actions-row" id="actions-row">
            <button class="download-btn" onclick="downloadStats()">⬇ Download Stats (CSV)</button>
        </div>

        <div class="results-grid" id="results" style="display: none;">
            <div class="stat-card"><h3>Count (n)</h3><div class="value" id="stat-n">-</div></div>
            <div class="stat-card"><h3>Mean</h3><div class="value" id="stat-mean">-</div></div>
            <div class="stat-card"><h3>Median</h3><div class="value" id="stat-median">-</div></div>
            <div class="stat-card"><h3>Mode</h3><div class="value" id="stat-mode">-</div></div>
            <div class="stat-card"><h3>Sum</h3><div class="value" id="stat-sum">-</div></div>
            <div class="stat-card"><h3>Std Deviation (s)</h3><div class="value" id="stat-sd">-</div></div>
            <div class="stat-card"><h3>Variance (s²)</h3><div class="value" id="stat-var">-</div></div>
            <div class="stat-card"><h3>Std Error (SE)</h3><div class="value" id="stat-se">-</div></div>
            <div class="stat-card"><h3>Coeff. of Variation</h3><div class="value" id="stat-cv">-</div></div>
            <div class="stat-card"><h3>Minimum</h3><div class="value" id="stat-min">-</div></div>
            <div class="stat-card"><h3>Maximum</h3><div class="value" id="stat-max">-</div></div>
            <div class="stat-card"><h3>Range</h3><div class="value" id="stat-range">-</div></div>
            <div class="stat-card"><h3>Q1 (25th Pct)</h3><div class="value" id="stat-q1">-</div></div>
            <div class="stat-card"><h3>Q3 (75th Pct)</h3><div class="value" id="stat-q3">-</div></div>
            <div class="stat-card"><h3>IQR</h3><div class="value" id="stat-iqr">-</div></div>
            <div class="stat-card"><h3>Skewness</h3><div class="value" id="stat-skew">-</div></div>
            <div class="stat-card"><h3>Kurtosis (excess)</h3><div class="value" id="stat-kurt">-</div></div>
            <div class="stat-card outlier-box">
                <h3>Detected Outliers (1.5×IQR rule)</h3>
                <div class="value" id="stat-outliers">None</div>
            </div>
        </div>

        <div class="viz-section" id="viz-section">
            <div class="viz-card">
                <h3>Histogram</h3>
                <svg id="histogram-svg" viewBox="0 0 400 220" xmlns="http://www.w3.org/2000/svg"></svg>
            </div>
            <div class="viz-card">
                <h3>Boxplot</h3>
                <svg id="boxplot-svg" viewBox="0 0 400 220" xmlns="http://www.w3.org/2000/svg"></svg>
            </div>
        </div>
    </section>

    <!-- JAVASCRIPT SYSTEM ENGINE -->
    <script>
        let globalData = {};
        let lastStatsSnapshot = null;
        let lastColumnName = '';

        // ---------- Upload handling (click + drag & drop) ----------

        function processData(event) {
            const file = event.target.files[0];
            if (!file) return;
            loadFile(file);
        }

        function loadFile(file) {
            if (!file.name.toLowerCase().endsWith('.csv')) {
                alert("Please upload a .csv file.");
                return;
            }
            document.getElementById('file-name').innerText = `> loaded: ${file.name}`;

            const reader = new FileReader();
            reader.onload = function (e) {
                parseMultiColumnCSV(e.target.result);
            };
            reader.onerror = function () {
                alert("Could not read the file. It may be corrupted.");
            };
            reader.readAsText(file);
        }

        const uploadZone = document.getElementById('upload-zone');
        ['dragenter', 'dragover'].forEach(evt => {
            uploadZone.addEventListener(evt, (e) => {
                e.preventDefault();
                e.stopPropagation();
                uploadZone.classList.add('drag-active');
            });
        });
        ['dragleave', 'drop'].forEach(evt => {
            uploadZone.addEventListener(evt, (e) => {
                e.preventDefault();
                e.stopPropagation();
                uploadZone.classList.remove('drag-active');
            });
        });
        uploadZone.addEventListener('drop', (e) => {
            const file = e.dataTransfer.files && e.dataTransfer.files[0];
            if (file) loadFile(file);
        });

        // ---------- Robust CSV parsing (handles quoted fields containing commas) ----------

        function parseCSVLine(line) {
            const result = [];
            let cur = '';
            let inQuotes = false;
            for (let i = 0; i < line.length; i++) {
                const ch = line[i];
                if (inQuotes) {
                    if (ch === '"') {
                        if (line[i + 1] === '"') { cur += '"'; i++; }
                        else { inQuotes = false; }
                    } else {
                        cur += ch;
                    }
                } else {
                    if (ch === '"') inQuotes = true;
                    else if (ch === ',') { result.push(cur); cur = ''; }
                    else cur += ch;
                }
            }
            result.push(cur);
            return result.map(v => v.trim());
        }

        function parseMultiColumnCSV(text) {
            globalData = {};
            const rows = text.split(/\r?\n/).filter(row => row.trim() !== '');

            if (rows.length < 2) {
                alert("File must contain at least a header row and one data row.");
                return;
            }

            const headers = parseCSVLine(rows[0]);
            const invalidCounts = {};
            headers.forEach(h => { globalData[h] = []; invalidCounts[h] = 0; });

            for (let i = 1; i < rows.length; i++) {
                const values = parseCSVLine(rows[i]);
                for (let j = 0; j < headers.length; j++) {
                    const raw = values[j];
                    if (raw === undefined || raw === '') continue;
                    const num = parseFloat(raw);
                    if (!isNaN(num) && isFinite(num)) {
                        globalData[headers[j]].push(num);
                    } else {
                        invalidCounts[headers[j]]++;
                    }
                }
            }
            globalData.__invalidCounts = invalidCounts;
            globalData.__totalRows = rows.length - 1;
            populateDropdown(headers);
        }

        function populateDropdown(headers) {
            const selectElement = document.getElementById('col-select');
            selectElement.innerHTML = '';
            let hasNumericData = false;

            headers.forEach(header => {
                if (globalData[header] && globalData[header].length > 0) {
                    hasNumericData = true;
                    const option = document.createElement('option');
                    option.value = header;
                    option.textContent = `${header} (n = ${globalData[header].length})`;
                    selectElement.appendChild(option);
                }
            });

            if (!hasNumericData) {
                alert("Could not detect any valid numerical columns in this file.");
                document.getElementById('column-selector').style.display = 'none';
                return;
            }

            document.getElementById('column-selector').style.display = 'block';
            analyzeSelectedColumn();
        }

        // ---------- Statistics ----------

        function getMedian(sortedArr) {
            const mid = Math.floor(sortedArr.length / 2);
            return sortedArr.length % 2 !== 0
                ? sortedArr[mid]
                : (sortedArr[mid - 1] + sortedArr[mid]) / 2;
        }

        function getMode(arr) {
            const freq = new Map();
            arr.forEach(v => freq.set(v, (freq.get(v) || 0) + 1));
            let maxFreq = 0;
            freq.forEach(f => { if (f > maxFreq) maxFreq = f; });
            if (maxFreq <= 1) return "No mode (all unique)";
            const modes = [...freq.entries()].filter(([, f]) => f === maxFreq).map(([v]) => v);
            const label = modes.slice(0, 5).join(', ') + (modes.length > 5 ? ', …' : '');
            return `${label} (×${maxFreq})`;
        }

        function analyzeSelectedColumn() {
            const selectedHeader = document.getElementById('col-select').value;
            lastColumnName = selectedHeader;
            const rawData = [...globalData[selectedHeader]];

            if (rawData.length === 0) return;

            rawData.sort((a, b) => a - b);
            const n = rawData.length;

            const sum = rawData.reduce((a, b) => a + b, 0);
            const mean = sum / n;
            const median = getMedian(rawData);
            const mode = getMode(rawData);
            const min = rawData[0];
            const max = rawData[n - 1];
            const range = max - min;

            let variance = 0, stdDev = 0, se = NaN, cv = NaN;
            if (n > 1) {
                variance = rawData.reduce((a, b) => a + Math.pow(b - mean, 2), 0) / (n - 1);
                stdDev = Math.sqrt(variance);
                se = stdDev / Math.sqrt(n);
                cv = mean !== 0 ? (stdDev / Math.abs(mean)) * 100 : NaN;
            }

            const q1Arr = rawData.slice(0, Math.floor(n / 2));
            const q3Arr = rawData.slice(Math.ceil(n / 2));
            const q1 = getMedian(q1Arr);
            const q3 = getMedian(q3Arr);
            const iqr = q3 - q1;

            const lowerBound = q1 - (1.5 * iqr);
            const upperBound = q3 + (1.5 * iqr);
            const outliers = rawData.filter(x => x < lowerBound || x > upperBound);

            // Skewness & excess kurtosis (sample-adjusted, Fisher-Pearson)
            let skewness = NaN, kurtosis = NaN;
            if (n >= 3) {
                const m2 = rawData.reduce((a, b) => a + Math.pow(b - mean, 2), 0) / n;
                const m3 = rawData.reduce((a, b) => a + Math.pow(b - mean, 3), 0) / n;
                const g1 = m3 / Math.pow(m2, 1.5);
                skewness = (Math.sqrt(n * (n - 1)) / (n - 2)) * g1;
                if (n >= 4) {
                    const m4 = rawData.reduce((a, b) => a + Math.pow(b - mean, 4), 0) / n;
                    const g2 = (m4 / (m2 * m2)) - 3;
                    kurtosis = ((n - 1) / ((n - 2) * (n - 3))) * ((n + 1) * g2 + 6);
                }
            }

            const roundNum = (num) => (num === undefined || isNaN(num)) ? '-' : Math.round(num * 10000) / 10000;

            document.getElementById('stat-n').innerText = n;
            document.getElementById('stat-mean').innerText = roundNum(mean);
            document.getElementById('stat-median').innerText = roundNum(median);
            document.getElementById('stat-mode').innerText = mode;
            document.getElementById('stat-sum').innerText = roundNum(sum);
            document.getElementById('stat-sd').innerText = roundNum(stdDev);
            document.getElementById('stat-var').innerText = roundNum(variance);
            document.getElementById('stat-se').innerText = roundNum(se);
            document.getElementById('stat-cv').innerText = isNaN(cv) ? '-' : `${roundNum(cv)}%`;
            document.getElementById('stat-min').innerText = min;
            document.getElementById('stat-max').innerText = max;
            document.getElementById('stat-range').innerText = roundNum(range);
            document.getElementById('stat-q1').innerText = roundNum(q1);
            document.getElementById('stat-q3').innerText = roundNum(q3);
            document.getElementById('stat-iqr').innerText = roundNum(iqr);
            document.getElementById('stat-skew').innerText = roundNum(skewness);
            document.getElementById('stat-kurt').innerText = roundNum(kurtosis);

            document.getElementById('stat-outliers').innerText = outliers.length > 0
                ? `${outliers.length} found: ${outliers.join(', ')}`
                : "No outliers detected";

            const invalid = (globalData.__invalidCounts && globalData.__invalidCounts[selectedHeader]) || 0;
            const metaEl = document.getElementById('col-meta');
            metaEl.innerText = invalid > 0
                ? `> ${invalid} non-numeric/missing value(s) skipped in this column`
                : `> all rows parsed as numeric`;

            document.getElementById('results').style.display = 'grid';
            document.getElementById('actions-row').style.display = 'flex';
            document.getElementById('viz-section').style.display = 'grid';

            lastStatsSnapshot = {
                column: selectedHeader, n, mean, median, mode, sum, stdDev, variance, se, cv,
                min, max, range, q1, q3, iqr, skewness, kurtosis, outlierCount: outliers.length,
                outliers,
            };

            renderHistogram(rawData);
            renderBoxplot(rawData, { min, q1, median, q3, max, lowerBound, upperBound, outliers });
        }

        // ---------- Visualizations (pure SVG, no external chart library) ----------

        function renderHistogram(sortedData) {
            const svg = document.getElementById('histogram-svg');
            svg.innerHTML = '';
            const n = sortedData.length;
            const min = sortedData[0];
            const max = sortedData[n - 1];

            const width = 400, height = 220, padding = { top: 10, right: 10, bottom: 25, left: 30 };
            const plotW = width - padding.left - padding.right;
            const plotH = height - padding.top - padding.bottom;

            if (max === min) {
                svg.innerHTML = `<text x="${width/2}" y="${height/2}" fill="#8b9bb4" font-size="12" text-anchor="middle">All values identical — no spread to bin.</text>`;
                return;
            }

            const binCount = Math.max(5, Math.ceil(Math.log2(n) + 1)); // Sturges' rule
            const binWidth = (max - min) / binCount;
            const bins = new Array(binCount).fill(0);

            sortedData.forEach(v => {
                let idx = Math.floor((v - min) / binWidth);
                if (idx >= binCount) idx = binCount - 1;
                if (idx < 0) idx = 0;
                bins[idx]++;
            });

            const maxFreq = Math.max(...bins);
            const barGap = 2;
            const barW = plotW / binCount - barGap;

            let svgContent = '';
            // axis line
            svgContent += `<line x1="${padding.left}" y1="${padding.top + plotH}" x2="${padding.left + plotW}" y2="${padding.top + plotH}" stroke="rgba(255,255,255,0.15)" />`;

            bins.forEach((freq, i) => {
                const barH = maxFreq > 0 ? (freq / maxFreq) * plotH : 0;
                const x = padding.left + i * (barW + barGap);
                const y = padding.top + (plotH - barH);
                svgContent += `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${barW.toFixed(1)}" height="${barH.toFixed(1)}" fill="#3b82f6" opacity="0.85"><title>${freq} obs</title></rect>`;
            });

            // min/max labels
            svgContent += `<text x="${padding.left}" y="${height - 6}" fill="#8b9bb4" font-size="10" font-family="Fira Code, monospace">${roundLabel(min)}</text>`;
            svgContent += `<text x="${padding.left + plotW}" y="${height - 6}" fill="#8b9bb4" font-size="10" font-family="Fira Code, monospace" text-anchor="end">${roundLabel(max)}</text>`;

            svg.innerHTML = svgContent;
        }

        function renderBoxplot(sortedData, stats) {
            const svg = document.getElementById('boxplot-svg');
            svg.innerHTML = '';
            const { min, q1, median, q3, max, lowerBound, upperBound, outliers } = stats;

            const width = 400, height = 220, padding = { top: 20, right: 20, bottom: 35, left: 20 };
            const plotW = width - padding.left - padding.right;
            const axisY = height / 2;

            const dataMin = sortedData[0];
            const dataMax = sortedData[sortedData.length - 1];
            const domainMin = Math.min(dataMin, lowerBound);
            const domainMax = Math.max(dataMax, upperBound);
            const span = (domainMax - domainMin) || 1;

            const scaleX = (v) => padding.left + ((v - domainMin) / span) * plotW;

            // whiskers = nearest data points within [lowerBound, upperBound]
            const nonOutliers = sortedData.filter(v => v >= lowerBound && v <= upperBound);
            const whiskerLow = nonOutliers.length ? nonOutliers[0] : min;
            const whiskerHigh = nonOutliers.length ? nonOutliers[nonOutliers.length - 1] : max;

            const boxH = 50;
            const boxTop = axisY - boxH / 2;
            const boxBottom = axisY + boxH / 2;

            let svgContent = '';
            // whisker lines
            svgContent += `<line x1="${scaleX(whiskerLow)}" y1="${axisY}" x2="${scaleX(q1)}" y2="${axisY}" stroke="#8b9bb4" stroke-width="1.5" />`;
            svgContent += `<line x1="${scaleX(q3)}" y1="${axisY}" x2="${scaleX(whiskerHigh)}" y2="${axisY}" stroke="#8b9bb4" stroke-width="1.5" />`;
            // whisker caps
            svgContent += `<line x1="${scaleX(whiskerLow)}" y1="${boxTop}" x2="${scaleX(whiskerLow)}" y2="${boxBottom}" stroke="#8b9bb4" stroke-width="1.5" />`;
            svgContent += `<line x1="${scaleX(whiskerHigh)}" y1="${boxTop}" x2="${scaleX(whiskerHigh)}" y2="${boxBottom}" stroke="#8b9bb4" stroke-width="1.5" />`;
            // box (Q1 -> Q3)
            svgContent += `<rect x="${scaleX(q1)}" y="${boxTop}" width="${(scaleX(q3) - scaleX(q1)).toFixed(1)}" height="${boxH}" fill="rgba(6,182,212,0.2)" stroke="#06b6d4" stroke-width="1.5" />`;
            // median line
            svgContent += `<line x1="${scaleX(median)}" y1="${boxTop}" x2="${scaleX(median)}" y2="${boxBottom}" stroke="#e2e8f0" stroke-width="2" />`;
            // outliers
            outliers.forEach(v => {
                svgContent += `<circle cx="${scaleX(v)}" cy="${axisY}" r="3.5" fill="#ef4444" opacity="0.85"><title>${v}</title></circle>`;
            });
            // axis labels
            svgContent += `<text x="${scaleX(domainMin)}" y="${height - 10}" fill="#8b9bb4" font-size="10" font-family="Fira Code, monospace">${roundLabel(domainMin)}</text>`;
            svgContent += `<text x="${scaleX(domainMax)}" y="${height - 10}" fill="#8b9bb4" font-size="10" font-family="Fira Code, monospace" text-anchor="end">${roundLabel(domainMax)}</text>`;
            svgContent += `<text x="${scaleX(median)}" y="${boxTop - 6}" fill="#e2e8f0" font-size="10" font-family="Fira Code, monospace" text-anchor="middle">median=${roundLabel(median)}</text>`;

            svg.innerHTML = svgContent;
        }

        function roundLabel(num) {
            return Math.round(num * 100) / 100;
        }

        // ---------- Export ----------

        function downloadStats() {
            if (!lastStatsSnapshot) return;
            const s = lastStatsSnapshot;
            const rows = [
                ['Statistic', 'Value'],
                ['Column', s.column],
                ['Count (n)', s.n],
                ['Mean', s.mean],
                ['Median', s.median],
                ['Mode', s.mode],
                ['Sum', s.sum],
                ['Std Deviation', s.stdDev],
                ['Variance', s.variance],
                ['Standard Error', s.se],
                ['Coefficient of Variation (%)', s.cv],
                ['Minimum', s.min],
                ['Maximum', s.max],
                ['Range', s.range],
                ['Q1', s.q1],
                ['Q3', s.q3],
                ['IQR', s.iqr],
                ['Skewness', s.skewness],
                ['Kurtosis (excess)', s.kurtosis],
                ['Outlier Count', s.outlierCount],
                ['Outliers', s.outliers.join(' | ')],
            ];
            const csvContent = rows.map(r => r.map(v => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\n');
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `MOD08_stats_${s.column}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }
    </script>
</body>
</html>
